{
  "name": "@kumokaizen/tanuki",
  "version": "1.0.2",
  "description": "Manage Cloudflare API credentials, group zones, and purge caches from the terminal",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tanuki": "bin/tanuki.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudflare",
    "cache",
    "purge",
    "tui",
    "terminal",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordspacegoat/tanuki.git",
    "directory": "packages/tanuki"
  },
  "optionalDependencies": {
    "@kumokaizen/tanuki-darwin-arm64": "1.0.2",
    "@kumokaizen/tanuki-darwin-x64": "1.0.2",
    "@kumokaizen/tanuki-linux-arm64": "1.0.2",
    "@kumokaizen/tanuki-linux-arm64-musl": "1.0.2",
    "@kumokaizen/tanuki-linux-x64": "1.0.2",
    "@kumokaizen/tanuki-linux-x64-musl": "1.0.2",
    "@kumokaizen/tanuki-win32-x64": "1.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/keymap": "0.6.6",
    "@opentui/react": "0.6.6",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile dist/tanuki",
    "screenshots": "bun run scripts/screenshots.tsx"
  }
}
